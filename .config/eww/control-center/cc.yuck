;; ══════════════════════════════════════════════════════════════════════
;;  Control Center  ·  included from ~/.config/eww/eww.yuck
;;  windows:  control-center  +  cc-closer
;; ══════════════════════════════════════════════════════════════════════

(defvar SH "bash $HOME/.config/eww/control-center/scripts")
(defvar confirm "")     ;; "" | "logout" | "suspend" | "reboot" | "shutdown"

;; ---- reactive state ---------------------------------------------------
;; NOTE: defpoll/deflisten command strings can't use eww vars, so the scripts
;; dir is spelled out via $HOME here.
(defpoll qs       :interval "2s"  :initial "{}"   "bash $HOME/.config/eww/control-center/scripts/state.sh")
(defpoll audio    :interval "1s"  :initial "{}"   "bash $HOME/.config/eww/control-center/scripts/audio.sh get")
(defpoll bright   :interval "2s"  :initial "50"   "bash $HOME/.config/eww/control-center/scripts/brightness.sh get")
(defpoll cc-clock :interval "20s" :initial ""     "date '+%A · %d %b · %H:%M'")
(defpoll cc-user  :interval "1h"  :initial "user" "whoami")
(deflisten media  :initial "{}"                   "bash $HOME/.config/eww/control-center/scripts/media.sh")

;; ══════════════════════════════════════════════════════════════════════
;;  Widgets
;; ══════════════════════════════════════════════════════════════════════

(defwidget cc []
  (box :class "cc" :orientation "v" :space-evenly false :spacing 13
    (cc-header)
    (cc-sliders)
    (cc-toggles)
    (cc-media)
    (cc-session)))

;; ---- header ----------------------------------------------------------
(defwidget cc-header []
  (box :class "cc-header" :orientation "h" :space-evenly false :spacing 12
    (box :class "cc-avatar")
    (box :orientation "v" :space-evenly false :hexpand true :valign "center"
      (label :class "cc-hi"   :halign "start" :text "Hi, ${cc-user}")
      (label :class "cc-date" :halign "start" :text cc-clock))
    (button :class "cc-lock" :tooltip "Lock"
      :onclick "${EWW_CMD} close control-center cc-closer ; ${SH}/session.sh lock" (label :text "󰌾"))))

;; ---- sliders --------------------------------------------------------------
(defwidget cc-sliders []
  (box :class "cc-card" :orientation "v" :space-evenly false :spacing 14
    (box :orientation "h" :space-evenly false :spacing 13
      (label :class "cc-sld-icon" :text "󰃟")
      (scale :class "cc-scale bright" :hexpand true :round-digits 0
        :value {bright ?: 50} :min 1 :max 100 :draw-value false
        :onchange "${SH}/brightness.sh set {}")
      (label :class "cc-sld-val" :text "${bright ?: 50}%"))
    (box :orientation "h" :space-evenly false :spacing 13
      (button :class "cc-sld-icon btn ${(audio?.mute ?: false) ? 'muted' : ''}" :timeout "3s"
        :tooltip "Mute" :onclick "${SH}/audio.sh mute ; ${SH}/ui.sh refresh -- ${EWW_CMD}"
        (label :text {audio?.icon ?: "󰕾"}))
      (scale :class "cc-scale vol" :hexpand true :round-digits 0
        :value {audio?.vol ?: 0} :min 0 :max 100 :draw-value false
        :onchange "${SH}/audio.sh set {}")
      (label :class "cc-sld-val" :text "${audio?.vol ?: 0}%"))))

;; ---- quick toggles ---------------------------------------------------
(defwidget cc-toggle [icon name sub active toggle]
  (eventbox :class "cc-toggle-evt" :cursor "pointer" :hexpand true :timeout "6s" :onclick toggle
    (box :class "cc-toggle ${active ? 'on' : ''}" :orientation "h" :space-evenly false :hexpand true
      (label :class "cc-toggle-ico" :valign "center" :text icon)
      (box :orientation "v" :space-evenly false :valign "center" :hexpand true
        (label :class "cc-toggle-name" :halign "start" :limit-width 18 :text name)
        (label :class "cc-toggle-sub"  :halign "start" :limit-width 18 :text sub)))))

(defwidget cc-toggles []
  (box :class "cc-grid" :orientation "v" :space-evenly false :spacing 9
    (box :orientation "h" :space-evenly true :spacing 9
      (cc-toggle :name "Wi-Fi" :icon {(qs?.wifi_on ?: false) ? "󰖩" : "󰖪"} :sub {qs?.wifi_sub ?: "…"}
        :active {qs?.wifi_on ?: false}
        :toggle "${SH}/toggle.sh wifi ; ${SH}/ui.sh refresh -- ${EWW_CMD}")
      (cc-toggle :name "Bluetooth" :icon {qs?.bt_icon ?: "󰂯"} :sub {qs?.bt_sub ?: "…"}
        :active {qs?.bt_on ?: false}
        :toggle "${SH}/toggle.sh bluetooth ; ${SH}/ui.sh refresh -- ${EWW_CMD}"))
    (box :orientation "h" :space-evenly true :spacing 9
      (cc-toggle :name "Night Light" :icon {(qs?.nl_on ?: false) ? "󰛨" : "󱩌"}
        :sub {(qs?.nl_on ?: false) ? "On" : "Off"} :active {qs?.nl_on ?: false}
        :toggle "${SH}/toggle.sh nightlight ; ${SH}/ui.sh refresh -- ${EWW_CMD}")
      (cc-toggle :name "Do Not Disturb" :icon "󰂛"
        :sub {(qs?.dnd_on ?: false) ? "On" : "Off"} :active {qs?.dnd_on ?: false}
        :toggle "${SH}/toggle.sh dnd ; ${SH}/ui.sh refresh -- ${EWW_CMD}"))
    (box :orientation "h" :space-evenly true :spacing 9
      (cc-toggle :name "Microphone" :icon {(qs?.mic_muted ?: false) ? "󰍭" : "󰍬"}
        :sub {(qs?.mic_muted ?: false) ? "Muted" : "On"} :active {!(qs?.mic_muted ?: false)}
        :toggle "${SH}/toggle.sh mic ; ${SH}/ui.sh refresh -- ${EWW_CMD}")
      (cc-toggle :name "Caffeine" :icon "󰅶"
        :sub {(qs?.caf_on ?: false) ? "On" : "Off"} :active {qs?.caf_on ?: false}
        :toggle "${SH}/toggle.sh caffeine ; ${SH}/ui.sh refresh -- ${EWW_CMD}"))))

;; ---- media player (revealed only when something is playing) --------------
(defwidget cc-media []
  (revealer :transition "slidedown" :duration "200ms" :reveal {media?.has ?: false}
    (box :class "cc-card cc-media" :orientation "h" :space-evenly false :spacing 12
      (box :orientation "v" :space-evenly false :hexpand true :valign "center"
        (label :class "cc-media-title"  :halign "start" :limit-width 26 :text {media?.title ?: ""})
        (label :class "cc-media-artist" :halign "start" :limit-width 26 :text {media?.artist ?: ""}))
      (box :orientation "h" :space-evenly false :spacing 4 :valign "center"
        (button :class "cc-mbtn" :onclick "playerctl previous" (label :text "󰒮"))
        (button :class "cc-mbtn play" :onclick "playerctl play-pause"
          (label :text {(media?.status ?: "") == "Playing" ? "󰏤" : "󰐊"}))
        (button :class "cc-mbtn" :onclick "playerctl next" (label :text "󰒭"))))))

;; ---- session row (confirm before the destructive ones) ---------------
(defwidget cc-session []
  (box :class "cc-session"
    (box :visible {confirm == ""} :orientation "h" :space-evenly true :spacing 9
      (button :class "cc-sbtn" :tooltip "Lock"
        :onclick "${EWW_CMD} close control-center cc-closer ; ${SH}/session.sh lock" (label :text "󰌾"))
      (button :class "cc-sbtn" :tooltip "Log out"
        :onclick "${SH}/ui.sh set confirm=logout -- ${EWW_CMD}" (label :text "󰗽"))
      (button :class "cc-sbtn" :tooltip "Suspend"
        :onclick "${SH}/ui.sh set confirm=suspend -- ${EWW_CMD}" (label :text "󰤄"))
      (button :class "cc-sbtn" :tooltip "Reboot"
        :onclick "${SH}/ui.sh set confirm=reboot -- ${EWW_CMD}" (label :text "󰜉"))
      (button :class "cc-sbtn danger" :tooltip "Shut down"
        :onclick "${SH}/ui.sh set confirm=shutdown -- ${EWW_CMD}" (label :text "󰐥")))
    (box :visible {confirm != ""} :class "cc-confirm" :orientation "h" :space-evenly false :spacing 8
      (label :class "cc-confirm-q" :hexpand true :halign "start"
        :text {confirm == "shutdown" ? "Shut down?" : confirm == "reboot" ? "Reboot?" : confirm == "suspend" ? "Suspend?" : "Log out?"})
      (button :class "cc-sbtn" :tooltip "Cancel"
        :onclick "${SH}/ui.sh set confirm= -- ${EWW_CMD}" (label :text "󰅖"))
      (button :class "cc-sbtn confirm-yes" :tooltip "Confirm"
        :onclick "${EWW_CMD} close control-center cc-closer ; ${SH}/ui.sh set confirm= -- ${EWW_CMD} ; ${SH}/session.sh ${confirm}" (label :text "󰄬")))))

;; ══════════════════════════════════════════════════════════════════════
;;  Windows
;;    cc-closer      — fullscreen; a click on it closes the panel
;;    control-center — the panel, on the "overlay" layer so it always sits
;;                     above cc-closer and receives its own clicks
;;  Both are focusable:false so the panel can never trap the keyboard.
;; ══════════════════════════════════════════════════════════════════════

(defwindow cc-closer
  :monitor 0
  :namespace "eww-cc-closer"
  :geometry (geometry :width "100%" :height "100%" :anchor "center")
  :stacking "fg"
  :focusable false
  (eventbox :class "cc-backdrop"
    :onclick "${EWW_CMD} close control-center cc-closer" (box)))

(defwindow control-center
  :monitor 0
  :namespace "eww-control-center"
  :geometry (geometry :x "4px" :y "3px" :width "392px" :anchor "top right")
  :stacking "overlay"
  :focusable false
  (cc))
