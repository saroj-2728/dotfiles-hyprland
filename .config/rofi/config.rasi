/* ─────────────────────────────────────────────────────────────
   rofi — matches the Waybar / control-center look
   dark frosted · thin stroke · blue accent (#89b4fa)
   ───────────────────────────────────────────────────────────── */

configuration {
    display-drun:        "󰍉";
    display-run:         "󰅬";
    display-window:      "󰖯";
    display-filebrowser: "󰉋";
    drun-display-format: "{name}";
    font:                "JetBrains Mono Nerd Font Medium 12";
    modi:                "drun,run,window,filebrowser";
    show-icons:          true;
    icon-theme:          "Adwaita";
    terminal:            "kitty";
    kb-cancel:           "Escape,MouseSecondary";
}

@theme "/dev/null"

* {
    accent:       #89b4fa;
    accent-soft:  rgba(137, 180, 250, 0.16);
    bg:           rgba(18, 19, 26, 0.86);
    bg-alt:       rgba(255, 255, 255, 0.055);
    stroke:       rgba(255, 255, 255, 0.09);
    fg:           #cdd6f4;
    fg-dim:       rgba(205, 214, 244, 0.55);
    urgent:       #f38ba8;

    background-color: transparent;
    text-color:       @fg;
    border:           0;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    width:            460px;
    background-color: @bg;
    border:           1px;
    border-color:     @stroke;
    border-radius:    13px;
    padding:          0;
}

mainbox {
    padding:   14px;
    spacing:   12px;
    children:  [ inputbar, listview ];
}

/* ---- search bar ---- */
inputbar {
    background-color: @bg-alt;
    border:           1px;
    border-color:     @stroke;
    border-radius:    9px;
    padding:          11px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font:       "JetBrains Mono Nerd Font 14";
    margin:     0 4px 0 2px;
    vertical-align: 0.5;
}

entry {
    text-color:        @fg;
    placeholder:       "Search";
    placeholder-color: @fg-dim;
    cursor:            text;
    vertical-align:    0.5;
}

/* ---- results ---- */
listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    scrollbar:        false;
    spacing:          3px;
    dynamic:          false;   /* keep a constant height while typing */
    fixed-height:     true;
}

element {
    background-color: transparent;
    text-color:      @fg-dim;
    padding:         11px 15px;
    spacing:         12px;
    border-radius:   8px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:      @fg-dim;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @accent-soft;
    text-color:      @fg;
}

element normal.urgent,
element alternate.urgent {
    text-color: @urgent;
}

element-icon {
    background-color: transparent;
    size:            22px;
    margin:          0 4px 0 0;
    vertical-align:  0.5;
}

element-text {
    background-color: transparent;
    text-color:      inherit;
    vertical-align:  0.5;
}

/* ---- mode tabs (only shown for combi) ---- */
mode-switcher {
    spacing: 6px;
    margin:  4px 0 0 0;
}

button {
    background-color: @bg-alt;
    text-color:      @fg-dim;
    border-radius:   8px;
    padding:         7px 14px;
    font:            "JetBrains Mono Nerd Font Medium 11";
}

button selected {
    background-color: @accent-soft;
    text-color:      @accent;
}

/* ---- message row (errors / info) ---- */
message {
    background-color: @bg-alt;
    border-radius:    8px;
    padding:          10px 12px;
    margin:           0 0 8px 0;
}

textbox {
    background-color: transparent;
    text-color:      @fg-dim;
    vertical-align:  0.5;
    padding: 20px;
}
